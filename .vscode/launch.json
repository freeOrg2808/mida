{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug CLI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "notes", 
                "update", 
                "--id", "1", 
                "--title", "This is my debug title"     
            ]
        }
    ]
}
